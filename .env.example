# Copy to .env.local for local development, and set the same values in
# Vercel → Settings → Environment Variables for production.
#
# .env* is gitignored (this template is the only exception). No secret
# here is referenced from client-side code, so nothing reaches the
# browser — src/lib/deliverInquiry.ts is marked server-only.

# ── Contact form delivery ───────────────────────────────────────────
# Pick ONE. If neither is set, inquiries are logged server-side instead
# of being delivered, and nothing is silently lost.

# 1. Resend (recommended). Key from resend.com/api-keys
RESEND_API_KEY=

# Where inquiries land. Defaults to siteConfig.email if unset.
CONTACT_INBOX=support@harizx.com

# Sender address. Must be on a domain verified in Resend. Use the
# send.harizx.com subdomain so Resend's DNS records don't collide with
# the existing Hostinger mail records on the root domain.
CONTACT_FROM="HarizX Site <site@send.harizx.com>"

# 2. Or post the inquiry as JSON to a webhook (Slack, Zapier, a CRM).
#    Ignored when RESEND_API_KEY is set.
CONTACT_WEBHOOK_URL=
