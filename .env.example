# Copy to .env.local and fill in. Never commit .env.local.
# .env* is gitignored — no secret in this project is referenced from
# client-side code, so nothing here is exposed to the browser.

# Where contact form inquiries are delivered. If unset, inquiries are
# logged server-side instead (see src/lib/deliverInquiry.ts).
CONTACT_WEBHOOK_URL=

# Optional, if you swap deliverInquiry.ts to an email provider:
# RESEND_API_KEY=
# CONTACT_INBOX=support@harizx.com
