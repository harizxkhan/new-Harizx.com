# Copy to .env.local for local development, and set the same values in
# Vercel → Settings → Environment Variables for production.
#
# .env* is gitignored (this template is the only exception). Nothing
# here is prefixed NEXT_PUBLIC_, so no value is inlined into the client
# bundle. src/lib/deliverInquiry.ts is marked `server-only`, so these
# are unreachable from client components by construction.

# ── Contact form delivery ───────────────────────────────────────────
# Modes are tried in this order: SMTP → Resend → webhook → server log.
# If none is configured, inquiries are logged rather than lost.

# 1. SMTP (Hostinger) — the active setup.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=support@harizx.com
SMTP_PASSWORD=
CONTACT_TO_EMAIL=support@harizx.com

# 2. Resend — alternative HTTP transport. Ignored while SMTP is set.
#    Sender must be on a domain verified in Resend; use the
#    send.harizx.com subdomain so its DNS records don't collide with
#    the Hostinger mail records on the root domain.
# RESEND_API_KEY=
# CONTACT_FROM="HarizX Site <site@send.harizx.com>"

# 3. Webhook — posts the inquiry as JSON (Slack, Zapier, a CRM).
#    Ignored while SMTP or Resend is set. Leave blank if unused.
CONTACT_WEBHOOK_URL=
